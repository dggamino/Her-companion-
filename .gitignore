# --- Logs y runtime ---
# Los logs operativos NO se versionan (ruido, rotación, tamaño).
# Los logs de validación de Sprint SÍ se versionan: son evidencia
# de Auditabilidad (HER-STD-0001, Criterio 10).
logs/*.log
!logs/*-validation.log
runtime/*.pid
runtime/*.sock

# --- Datos sensibles (HER-STD-0001, Criterio 9) ---
knowledge/private/
knowledge/expedientes/
*.expediente
*.pdf.private

# --- Node (Netlify / WAHA tooling) ---
node_modules/
.netlify/

# --- Archivos temporales ---
*.tmp
*.bak
*.orig
